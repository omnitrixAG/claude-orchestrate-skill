{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "backend",
    "model",
    "starting_commit",
    "lane_id",
    "wall_time_seconds",
    "changed_files",
    "diff_stats",
    "test_command",
    "test_exit_code",
    "test_result",
    "scope_result",
    "errors",
    "limitations"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["ok", "backend_failed", "timeout", "tests_failed", "scope_violation", "forbidden_hit"] },
    "backend": { "type": "string", "enum": ["codex", "opencode"] },
    "model": { "type": "string", "minLength": 1 },
    "starting_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "lane_id": { "type": "string", "minLength": 1 },
    "wall_time_seconds": { "type": "number", "minimum": 0 },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "diff_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "insertions", "deletions", "untracked"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "insertions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "untracked": { "type": "integer", "minimum": 0 }
      }
    },
    "test_command": { "type": "string" },
    "test_exit_code": { "type": ["integer", "null"] },
    "test_result": { "type": "string", "enum": ["passed", "failed", "skipped", "timeout"] },
    "scope_result": { "type": "string", "enum": ["respected", "violated", "not_evaluated"] },
    "errors": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
